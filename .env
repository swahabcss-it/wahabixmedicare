# Copy this file to .env and fill in real values. NEVER commit the real .env file.

# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-this-to-a-random-50-char-secret

DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
BASE_DOMAIN=cliniq.com

# Only set this to True once you have a real HTTPS domain in front of the
# app (e.g. behind Nginx with a certificate). Leave False for any
# http://ip:port or http://localhost testing, even if DEBUG=False —
# otherwise every form on the site will silently fail CSRF validation.
USE_HTTPS_SECURE_COOKIES=True

# Shows quick-login demo buttons on the login page. Set False (or delete
# the block in templates/base/login.html) before going live.
SHOW_DEMO_LOGIN=True

# Postgres (used automatically if set; falls back to SQLite if omitted)
DATABASE_URL=postgresql://wmsuser:strongpassword@db:5432/wmsdb

# Lab analyzer machine webhook shared secret — required in production
ANALYZER_API_KEY=generate-a-long-random-key-per-deployment

MEDIA_ROOT=/var/www/wms/media
STATIC_ROOT=/var/www/wms/staticfiles

# Login brute-force throttling
LOGIN_ATTEMPT_LIMIT=5
LOGIN_ATTEMPT_WINDOW_SECONDS=300

# WhatsApp notifications (optional) — leave blank to keep it a safe no-op.
# See apps/core/services/notifications.py for setup instructions.
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_FROM_NUMBER=
